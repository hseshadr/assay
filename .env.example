# Assay does not auto-load dotenv files. These optional values show shipped defaults.
# To load a copied .env explicitly in a POSIX shell: set -a; . ./.env; set +a
ASSAY_MIN_SAMPLES=30              # abstain below this many samples
ASSAY_BOOTSTRAP_RESAMPLES=9999    # scipy bootstrap resamples
ASSAY_CONFIDENCE_LEVEL=0.95       # confidence interval level
ASSAY_ECE_BINS=15                 # reliability-diagram bins for ECE
ASSAY_BOOTSTRAP_SEED=12345        # fixed seed → reproducible intervals
ASSAY_RANKING_K=10                # ranking cutoff
