{
  "name": "@edgeproc/receipt-ui",
  "version": "0.2.0",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "description": "React components that render and verify an Avow SignedReceipt — a composable badge and panel with a fail-closed, three-state verdict (verified / tampered / untrusted signer).",
  "keywords": [
    "react",
    "react-components",
    "ed25519",
    "signature-verification",
    "signed-receipt",
    "tamper-evident",
    "provenance",
    "fail-closed",
    "avow",
    "audit-ui",
    "trust-badge",
    "typescript"
  ],
  "license": "MIT",
  "author": "Harish Seshadri",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hseshadr/assay.git",
    "directory": "ts/packages/receipt-ui"
  },
  "homepage": "https://github.com/hseshadr/assay",
  "engines": {
    "node": ">=22.13"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "gate": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "peerDependencies": {
    "@edgeproc/avow": "^0.1.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@edgeproc/avow": "workspace:*",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^26.1.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^4.1.7",
    "jsdom": "^26.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.9.2",
    "vitest": "^4.1.7"
  }
}
